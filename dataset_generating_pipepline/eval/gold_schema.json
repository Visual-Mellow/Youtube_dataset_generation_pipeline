{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Layer0GoldClip",
  "type": "object",
  "required": ["clip_id", "events"],
  "properties": {
    "clip_id": {
      "type": "string",
      "description": "Clip id, optionally namespaced as video_id/clip_id"
    },
    "video_id": { "type": "string" },
    "video_type": { "type": "string" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "onset_ms", "offset_ms"],
        "properties": {
          "label": { "type": "string" },
          "onset_ms": { "type": "number" },
          "offset_ms": { "type": "number" },
          "audio_type": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
